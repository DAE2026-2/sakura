---
import Layout from '../layouts/Layout.astro';
import AdminShell from '../components/AdminShell.astro';
---

<Layout title="Pedidos · Sakura" description="Pedidos por mesa" noindex landing={false}>
  <AdminShell actual="mesero" roles={['ADMIN', 'MESERO']}>
    <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr]">
      <section aria-labelledby="mesas-title">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-sm text-sakura">Sala</p>
            <h1 id="mesas-title" class="mt-2 text-3xl lg:text-4xl">Mesas</h1>
          </div>
          <p class="flex gap-4 text-xs text-crema/60">
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-crema/40"></span>Disponible</span>
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-sakura"></span>Ocupada</span>
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full border border-dashed border-crema/70"></span>Reservada</span>
          </p>
        </div>
        <p data-resumen aria-live="polite" class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs text-crema/70"></p>
        <ul data-mesas class="mt-6 grid grid-cols-3 gap-x-3 gap-y-5 sm:grid-cols-4"></ul>
      </section>

      <section data-pedido aria-live="polite" class="rounded-3xl p-6 ring-1 ring-crema/15 lg:p-8">
        <p class="text-crema/60">Elige una mesa para abrir o ver su pedido.</p>
      </section>
    </div>
    <p data-panel-error role="alert" class="field-error mt-4"></p>
  </AdminShell>
</Layout>

<script>
  import { initMesero } from '../scripts/mesero';
  initMesero();
</script>
