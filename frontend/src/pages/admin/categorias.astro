---
import Layout from '../../layouts/Layout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<Layout title="Categorías · Sakura" description="Gestión de categorías del menú" noindex landing={false}>
  <AdminShell actual="categorias">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-sm text-sakura">Menú</p>
        <h1 class="mt-2 text-3xl lg:text-5xl">Categorías</h1>
      </div>
      <button type="button" data-nuevo class="btn btn-primary"><span>Nueva categoría</span></button>
    </div>

    <div class="mt-8 overflow-x-auto rounded-3xl ring-1 ring-crema/15">
      <table class="w-full min-w-[560px] text-left text-sm">
        <thead class="text-xs tracking-widest text-crema/50 uppercase">
          <tr>
            <th class="px-4 py-3 font-medium">Orden</th>
            <th class="px-4 py-3 font-medium">Nombre</th>
            <th class="px-4 py-3 font-medium">Descripción</th>
            <th class="px-4 py-3 font-medium"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody data-filas class="divide-y divide-crema/10"></tbody>
      </table>
    </div>
    <p data-panel-error role="alert" class="field-error mt-4"></p>

    <dialog data-dialogo class="m-auto w-[min(92vw,480px)] rounded-3xl bg-bg p-0 text-crema ring-1 ring-crema/15 backdrop:bg-bg/70 backdrop:backdrop-blur-sm">
      <form data-form novalidate class="flex flex-col gap-4 p-6 lg:p-8">
        <h2 class="text-2xl" data-dialogo-titulo>Nueva categoría</h2>
        <input type="hidden" name="id" />
        <label class="field">Nombre<input class="input" name="nombre" maxlength="40" required /><span class="field-error" data-error="nombre"></span></label>
        <label class="field">Descripción<input class="input" name="descripcion" maxlength="200" /><span class="field-error" data-error="descripcion"></span></label>
        <label class="field">Orden<input class="input" name="orden" type="number" min="0" value="0" /><span class="field-error" data-error="orden"></span></label>
        <p data-form-error role="alert" class="field-error"></p>
        <div class="flex justify-end gap-2">
          <button type="button" data-cancelar class="btn btn-ghost"><span>Cancelar</span></button>
          <button type="submit" class="btn btn-primary"><span>Guardar</span></button>
        </div>
      </form>
    </dialog>
  </AdminShell>
</Layout>

<script>
  import { initCategorias } from '../../scripts/admin-categorias';
  initCategorias();
</script>
