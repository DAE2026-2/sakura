---
import Layout from '../../layouts/Layout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<Layout title="Productos · Sakura" description="Gestión de productos del menú" noindex landing={false}>
  <AdminShell actual="productos">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-sm text-sakura">Menú</p>
        <h1 class="mt-2 text-3xl lg:text-5xl">Productos</h1>
      </div>
      <div class="flex flex-wrap items-end gap-2">
        <label class="field">Categoría
          <select class="input" data-filtro><option value="">Todas</option></select>
        </label>
        <button type="button" data-nuevo class="btn btn-primary"><span>Nuevo producto</span></button>
      </div>
    </div>

    <div class="mt-8 overflow-x-auto rounded-3xl ring-1 ring-crema/15">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="text-xs tracking-widest text-crema/50 uppercase">
          <tr>
            <th class="px-4 py-3 font-medium">Orden</th>
            <th class="px-4 py-3 font-medium">Producto</th>
            <th class="px-4 py-3 font-medium">Categoría</th>
            <th class="px-4 py-3 font-medium">Precio</th>
            <th class="px-4 py-3 font-medium">Disponible</th>
            <th class="px-4 py-3 font-medium"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody data-filas class="divide-y divide-crema/10"></tbody>
      </table>
    </div>
    <p data-panel-error role="alert" class="field-error mt-4"></p>

    <dialog data-dialogo class="m-auto w-[min(92vw,560px)] rounded-3xl bg-bg p-0 text-crema ring-1 ring-crema/15 backdrop:bg-bg/70 backdrop:backdrop-blur-sm">
      <form data-form novalidate class="flex flex-col gap-4 p-6 lg:p-8">
        <h2 class="text-2xl" data-dialogo-titulo>Nuevo producto</h2>
        <input type="hidden" name="id" />
        <label class="field">Nombre<input class="input" name="nombre" maxlength="120" required /><span class="field-error" data-error="nombre"></span></label>
        <label class="field">Descripción<textarea class="input min-h-20" name="descripcion" maxlength="300"></textarea><span class="field-error" data-error="descripcion"></span></label>
        <div class="grid gap-4 sm:grid-cols-3">
          <label class="field">Categoría<select class="input" name="categoriaId" required></select><span class="field-error" data-error="categoriaId"></span></label>
          <label class="field">Precio (COP)<input class="input" name="precio" type="number" min="0" step="500" required /><span class="field-error" data-error="precio"></span></label>
          <label class="field">Orden<input class="input" name="orden" type="number" min="0" value="0" /><span class="field-error" data-error="orden"></span></label>
        </div>
        <div class="flex flex-wrap gap-6 text-sm">
          <label class="inline-flex items-center gap-3"><input type="checkbox" name="disponible" class="size-4 accent-[var(--color-sakura)]" /> Disponible</label>
          <label class="inline-flex items-center gap-3"><input type="checkbox" name="destacado" class="size-4 accent-[var(--color-sakura)]" /> Destacado en la landing</label>
        </div>
        <p data-form-error role="alert" class="field-error"></p>
        <div class="flex justify-end gap-2">
          <button type="button" data-cancelar class="btn btn-ghost"><span>Cancelar</span></button>
          <button type="submit" class="btn btn-primary"><span>Guardar</span></button>
        </div>
      </form>
    </dialog>
  </AdminShell>
</Layout>

<script>
  import { initProductos } from '../../scripts/admin-productos';
  initProductos();
</script>
