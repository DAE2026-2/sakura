---
import Icon from './Icon.astro';
import { getFaqs } from '../lib/api';
import { contacto } from '../data/sakura';

// Las preguntas viven en la tabla `faq` de la base de datos.
const faqs = await getFaqs();
---

<section id="preguntas" data-spy="#preguntas" aria-labelledby="faq-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p data-reveal class="text-sm text-sakura">Preguntas frecuentes</p>
      <h2 id="faq-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">Antes de venir</h2>
      <p data-reveal style="--d:200ms" class="mt-6 max-w-sm text-base text-crema/70">
        ¿Te queda alguna duda? Llámanos al <a href={contacto.telefonoHref} class="link whitespace-nowrap">{contacto.telefono}</a>.
      </p>
    </div>

    <div class="divide-y divide-crema/10">
      {
        faqs.map((faq) => (
          <details data-reveal class="faq group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-xl py-6 text-left text-lg transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-sakura">
              <h3 class="font-sans text-lg">{faq.pregunta}</h3>
              <Icon name="plus" class="faq-icon size-6 shrink-0 text-sakura" />
            </summary>
            <div class="pb-6">
              <p class="max-w-2xl text-base text-crema/70">{faq.respuesta}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
