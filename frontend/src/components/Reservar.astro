---
import Icon from './Icon.astro';
import { contacto } from '../data/sakura';
import { API_URL } from '../lib/api';

const personas = Array.from({ length: 8 }, (_, i) => i + 1);
---

<section id="reservar" aria-labelledby="reservar-title" class="relative overflow-hidden px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <p data-reveal class="text-sm text-sakura">Reservas</p>
      <h2 id="reservar-title" data-reveal style="--d:100ms" class="mt-4 text-4xl lg:text-6xl">Reserva tu mesa</h2>
      <p data-reveal style="--d:200ms" class="mt-6 max-w-sm text-base text-crema/70 lg:text-lg">
        Online para 1 a 8 personas y hasta 60 días antes. Para grupos más grandes, llámanos.
      </p>
      <ul data-reveal style="--d:300ms" class="mt-8 flex flex-col gap-3 text-sm text-crema/80">
        {contacto.horario.map((h) => (
          <li class="inline-flex items-center gap-2"><Icon name="clock" class="size-4 text-sakura" />{h.dias}: {h.horas}</li>
        ))}
        <li>
          <a href={contacto.telefonoHref} class="link inline-flex items-center gap-2">
            <Icon name="phone" class="size-4 text-sakura" />{contacto.telefono}
          </a>
        </li>
      </ul>
    </div>

    <div data-reveal style="--d:100ms" class="rounded-3xl p-6 ring-1 ring-crema/15 lg:p-8">
      <form data-reserva data-api={API_URL} novalidate class="flex flex-col gap-6">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field">
            Día
            <input class="input" type="date" name="fecha" required />
            <span class="field-error" data-error="fecha"></span>
          </label>
          <label class="field">
            Personas
            <select class="input" name="personas">
              {personas.map((n) => <option value={n} selected={n === 2}>{n} {n === 1 ? 'persona' : 'personas'}</option>)}
            </select>
            <span class="field-error" data-error="personas"></span>
          </label>
        </div>

        <fieldset class="field">
          <legend class="mb-2">Hora</legend>
          <div data-horas class="flex min-h-10 flex-wrap gap-2" aria-live="polite">
            <p class="text-sm text-crema/50">Elige un día para ver las horas libres.</p>
          </div>
          <span class="field-error" data-error="hora"></span>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field sm:col-span-2">
            Nombre
            <input class="input" type="text" name="nombre" autocomplete="name" maxlength="80" required />
            <span class="field-error" data-error="nombre"></span>
          </label>
          <label class="field">
            Email
            <input class="input" type="email" name="email" autocomplete="email" maxlength="120" required />
            <span class="field-error" data-error="email"></span>
          </label>
          <label class="field">
            Teléfono
            <input class="input" type="tel" name="telefono" autocomplete="tel" maxlength="30" required />
            <span class="field-error" data-error="telefono"></span>
          </label>
          <label class="field sm:col-span-2">
            Notas (opcional)
            <textarea class="input min-h-24" name="notas" maxlength="500" placeholder="Alergias, celebraciones, ambiente preferido…"></textarea>
            <span class="field-error" data-error="notas"></span>
          </label>
        </div>

        <p data-form-error role="alert" class="field-error text-sm"></p>
        <button type="submit" class="btn btn-primary self-start px-6"><span>Confirmar reserva</span></button>
      </form>

      <div data-confirmacion hidden tabindex="-1" class="flex flex-col items-start gap-4 outline-none">
        <p class="text-sm text-sakura">Reserva recibida</p>
        <p class="font-display text-3xl lg:text-4xl" data-resumen></p>
        <p class="text-base text-crema/70">Tu código de reserva es</p>
        <p class="rounded-2xl px-5 py-3 font-display text-4xl tracking-widest text-sakura ring-1 ring-sakura/60" data-codigo></p>
        <p class="max-w-md text-sm text-crema/60">Guárdalo: con él y tu email puedes consultar o cancelar la reserva aquí mismo.</p>
        <button type="button" data-otra class="btn btn-ghost"><span>Hacer otra reserva</span></button>
      </div>
    </div>
  </div>

  <details class="faq mx-auto mt-12 max-w-6xl rounded-3xl px-6 ring-1 ring-crema/15 lg:px-8">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg hover:text-sakura">
      <span>¿Ya tienes una reserva? Consúltala o cancélala</span>
      <Icon name="plus" class="faq-icon size-6 shrink-0 text-sakura" />
    </summary>
    <form data-gestion novalidate class="grid gap-4 pb-6 sm:grid-cols-[1fr_1.5fr_auto] sm:items-start">
      <label class="field">
        Código
        <input class="input uppercase" type="text" name="codigo" placeholder="SAK-XXXX" maxlength="12" required />
      </label>
      <label class="field">
        Email de la reserva
        <input class="input" type="email" name="email" autocomplete="email" required />
      </label>
      <button type="submit" class="btn btn-ghost sm:mt-7"><span>Consultar</span></button>
      <div data-gestion-resultado aria-live="polite" class="text-base sm:col-span-3"></div>
    </form>
  </details>
</section>

<script>
  import { initReservas } from '../scripts/reservas';
  initReservas();
</script>
