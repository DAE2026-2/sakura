---
import { Picture } from 'astro:assets';
import Pending from './Pending.astro';
import Stop from './Stop.astro';
import { paseo } from '../data/sakura';
import { getExperiencias, precio } from '../lib/api';

const { paradas } = paseo;
// Los precios de la parada "Menús" salen de la tabla `experiencia`.
const experiencias = await getExperiencias();
const body = 'mt-4 max-w-md text-base text-crema/80 lg:text-lg';
const title = 'mt-4 max-w-xl text-4xl lg:text-5xl xl:text-6xl';
const pill = 'rounded-full bg-bg/40 px-3 py-1 ring-1 ring-crema/20 backdrop-blur-md';
---

<section id="recorrido" data-world aria-label="Paseo por Sakura" class="relative">
  <!-- Escenario fijo: los clips del paseo ocupan toda la pantalla. Debajo, el primer fotograma de cada clip, con el mismo
       encuadre, para que el vídeo entre sin que se note el cambio. -->
  <div data-stage class="sticky top-0 h-lvh overflow-hidden bg-bg" style="--focus-x: 50%">
    <div aria-hidden="true" class="absolute inset-0">
      {
        paradas.map((parada, i) => (
          <div data-frame class="frame absolute inset-0" style={i === 0 ? undefined : 'opacity: 0'}>
            <Picture
              src={parada.poster}
              alt=""
              formats={['avif', 'webp']}
              widths={[828, 1280, 1920]}
              sizes="(min-aspect-ratio: 16/9) 100vw, 178vh"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
              pictureAttributes={{ class: 'block size-full' }}
              class="size-full object-cover"
              style="object-position: var(--focus-x) 50%"
            />
          </div>
        ))
      }
      <div class="clips absolute inset-0">
        {
          paradas.map((parada) => (
            <video
              data-clip
              data-src={parada.clip}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              class="clip absolute inset-0 size-full object-cover"
            />
          ))
        }
      </div>
    </div>

    <!-- Velos para leer el texto encima del vídeo. -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-bg/60 to-transparent"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-bg from-15% via-bg/50 via-50% to-transparent to-80% lg:bg-linear-to-r lg:from-bg/90 lg:via-bg/40 lg:via-35% lg:to-transparent lg:to-65%"
    >
    </div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 hidden h-1/2 bg-linear-to-t from-bg/80 to-transparent lg:block"></div>

    <!-- Raíl de paradas. -->
    <nav aria-label="Paradas del paseo" class="absolute top-1/2 right-6 hidden -translate-y-1/2 lg:block xl:right-8">
      <ol class="relative flex flex-col items-end gap-4">
        <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-crema/20">
          <span data-rail-fill class="absolute inset-0 origin-top scale-y-0 bg-sakura"></span>
        </span>
        {
          paradas.map((parada, i) => (
            <li>
              <a href={`#${parada.id}`} data-goto aria-current={i === 0 ? 'true' : 'false'} class="rail-link group flex h-6 items-center gap-3">
                <span class="rail-label rounded-full bg-bg/60 px-3 py-1 text-xs whitespace-nowrap text-crema ring-1 ring-crema/10 backdrop-blur-xl">
                  {parada.lugar}
                </span>
                <span class="relative grid size-2 place-items-center">
                  <span class="rail-dot size-2 rounded-full bg-crema/50" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p
      data-hint
      aria-hidden="true"
      class="absolute right-8 bottom-8 hidden items-center gap-3 text-xs tracking-widest text-crema/70 uppercase lg:flex"
    >
      Desliza para recorrer Sakura
      <span class="hint-line relative block h-8 w-px overflow-hidden bg-crema/20"></span>
    </p>
  </div>

  <!-- Paradas: cada una deja su texto abajo a la izquierda mientras el paseo avanza. -->
  <div class="relative z-10 -mt-[100lvh]">
    <Stop index={0} spy="#inicio">
      <h1 class="mt-4">
        <span class="block font-sans text-xs font-medium tracking-widest text-sakura uppercase">
          Sakura · Restaurante japonés
        </span>
        <span
          class="hero-title mt-4 block max-w-[680px] bg-linear-to-r from-crema to-[#c9b3b9] bg-clip-text pb-2 text-4xl text-transparent lg:text-6xl"
        >
          Cocina japonesa<br /> bajo los cerezos
        </span>
      </h1>
      <p class={body}>
        Omakase, barra teppanyaki y pescado del día. Comidas y cenas todos los días, con reserva online en segundos.
      </p>
      <a href="#reservar" class="btn btn-primary mt-6"><span>Reservar mesa</span></a>
      <ul class="mt-6 flex flex-wrap gap-2 text-xs text-crema/80" aria-label="Lo que encontrarás">
        <li class={pill}>Omakase de 9 pases</li>
        <li class={pill}>Barra teppanyaki</li>
        <li class={pill}>Terraza de cerezos</li>
      </ul>
    </Stop>

    <Stop index={1} eyebrow="Qué es Sakura">
      <h2 class={title}>Técnica japonesa, producto de temporada</h2>
      <p class={body}>
        Sakura es la flor del cerezo: dura pocos días y por eso se celebra. Cocinamos igual, con lo mejor de cada
        temporada y sin prisas.
      </p>
    </Stop>

    <Stop index={2} eyebrow="Menús">
      <h2 class={title}>Sabes lo que cuesta antes de sentarte</h2>
      <p class={body}>Menús cerrados con el precio a la vista. También puedes pedir a la carta.</p>
      {
        experiencias.length > 0 ? (
          <dl class="mt-6 grid w-full max-w-lg grid-cols-3 gap-4">
            {experiencias.map((exp) => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-xs text-crema/60">{exp.nombre}</dt>
                <dd class="font-display text-xl tabular-nums lg:text-3xl">{precio(exp.precio)}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <Pending class="mt-6 max-w-md">Sin conexión con la API: arranca el backend para ver los precios.</Pending>
        )
      }
      <a href="#experiencias" class="link mt-6 text-sm">Ver qué incluye cada menú</a>
    </Stop>

    <Stop index={3} eyebrow="Comidas y cenas">
      <h2 class={title}>Una sala tranquila, a mediodía o de noche</h2>
      <p class={body}>
        Comidas de 13:00 a 16:00 y cenas de 20:00 a 23:30. Mesas para dos, para la familia o para celebrar.
      </p>
      <ul class="mt-6 grid w-full max-w-md grid-cols-2 gap-4">
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">13:00</span>
          <span class="text-xs text-crema/70 lg:text-sm">Primer turno de comidas</span>
        </li>
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">20:00</span>
          <span class="text-xs text-crema/70 lg:text-sm">Primer turno de cenas</span>
        </li>
      </ul>
    </Stop>

    <Stop index={4} eyebrow="La barra">
      <h2 class={title}>Siéntate frente al itamae</h2>
      <p class={body}>
        En la barra, el cocinero prepara cada pieza delante de ti y te la sirve en cuanto está lista. Es el mejor sitio
        para el omakase.
      </p>
      <div class="mt-6 flex items-end gap-4">
        <span class="font-display text-5xl text-sakura lg:text-7xl">9</span>
        <span class="max-w-48 pb-1 text-sm text-crema/70">Pases en el omakase, elegidos por el chef cada día</span>
      </div>
    </Stop>

    <Stop index={5} eyebrow="Cómo funciona">
      <h2 class={title}>Tu mesa, en tres pasos</h2>
      <ol class="mt-6 flex max-w-md flex-col gap-4">
        <li class="flex gap-4">
          <span class="font-display text-2xl text-sakura">1</span>
          <div>
            <h3 class="text-lg">Elige día y personas</h3>
            <p class="text-sm text-crema/70">Te mostramos al momento las horas con mesa libre.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-sakura">2</span>
          <div>
            <h3 class="text-lg">Deja tus datos</h3>
            <p class="text-sm text-crema/70">Nombre, email y teléfono, y si quieres, una nota para cocina.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-sakura">3</span>
          <div>
            <h3 class="text-lg">Guarda tu código</h3>
            <p class="text-sm text-crema/70">Con él puedes consultar o cancelar la reserva cuando quieras.</p>
          </div>
        </li>
      </ol>
      <a href="#reservar" class="btn btn-primary mt-6"><span>Reservar mesa</span></a>
    </Stop>
  </div>
</section>

<style>
  .frame {
    will-change: opacity, transform;
  }

  .clips {
    opacity: 0;
    transition: opacity 1200ms var(--ease-fluid);
  }

  [data-mode='video'] .clips {
    opacity: 1;
  }

  /* Solo se ve el clip del tramo actual; el cambio entre clips es instantáneo porque comparten fotograma. */
  .clip {
    object-position: var(--focus-x) 50%;
    visibility: hidden;
  }

  .clip.is-shown {
    visibility: visible;
  }

  .rail-label {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-dot {
    transition:
      background-color 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-link:hover .rail-label,
  .rail-link:focus-visible .rail-label,
  .rail-link[aria-current='true'] .rail-label {
    opacity: 1;
    transform: none;
  }

  .rail-link:hover .rail-dot {
    background-color: var(--color-crema);
  }

  .rail-link[aria-current='true'] .rail-dot {
    background-color: var(--color-sakura);
    transform: scale(1.5);
  }

  .hint-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-crema);
    animation: hint 2400ms var(--ease-fluid) infinite;
  }

  @keyframes hint {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-line::after {
      animation: none;
    }
  }
</style>
