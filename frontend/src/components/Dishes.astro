---
import Pending from './Pending.astro';
import { CATEGORIA_MENUS, getMenu, precio, srcsetProducto } from '../lib/api';

// El menú vive en las tablas `categoria` y `producto`; la API solo devuelve los productos disponibles.
const menu = await getMenu();
// Los menús degustación ya tienen su sección (Experiencias); aquí solo va la carta.
const platos = menu
  .filter((c) => c.nombre !== CATEGORIA_MENUS)
  .flatMap((c) => c.productos)
  .sort((a, b) => a.orden - b.orden);
const destacados = platos.filter((p) => p.destacado);
const resto = platos.filter((p) => !p.destacado);
---

<section id="carta" data-spy="#carta" aria-labelledby="carta-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p data-reveal class="text-sm text-sakura">La carta</p>
      <h2 id="carta-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">Lo que llega a la mesa</h2>
    </div>

    {platos.length === 0 && <Pending class="mt-8">No se pudo cargar la carta. Arranca el backend en el puerto 8080.</Pending>}

    <ol class="mt-12 divide-y divide-crema/10">
      {
        destacados.map((plato, i) => (
          <li data-reveal style={`--d:${i * 80}ms`} class="grid grid-cols-[auto_1fr_auto] items-center gap-x-4 gap-y-1 py-6 sm:gap-x-6 lg:py-8">
            {plato.imagen ? (
              <div class="mirror-frame w-24 rounded-3xl sm:w-40 lg:w-48">
                <img
                  src={plato.imagen}
                  srcset={srcsetProducto(plato.imagen)}
                  sizes="(min-width: 1024px) 192px, (min-width: 640px) 160px, 96px"
                  width="800"
                  height="600"
                  alt={`${plato.nombre}: ${plato.descripcion ?? plato.categoria}`}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full rounded-2xl object-cover"
                />
              </div>
            ) : (
              <span class="w-24 text-center font-display text-sm text-sakura tabular-nums sm:w-40 lg:w-48">{String(i + 1).padStart(2, '0')}</span>
            )}
            <div>
              <p class="text-xs tracking-widest text-crema/50 uppercase">{plato.categoria}</p>
              <h3 class="mt-2 text-xl sm:text-2xl lg:text-4xl">{plato.nombre}</h3>
              {plato.descripcion && <p class="mt-2 text-sm text-crema/70 sm:text-base">{plato.descripcion}</p>}
            </div>
            <p class="font-display text-base tabular-nums sm:text-lg lg:text-2xl">{precio(plato.precio)}</p>
          </li>
        ))
      }
    </ol>

    {
      resto.length > 0 && (
        <div data-reveal class="mt-12 rounded-3xl p-6 ring-1 ring-crema/15 lg:p-8">
          <h3 class="text-xl">Para acompañar</h3>
          <ul class="mt-4 grid gap-x-12 gap-y-3 md:grid-cols-2">
            {resto.map((plato) => (
              <li class="flex items-center justify-between gap-4 text-base">
                <span class="flex items-center gap-3">
                  {plato.imagen && (
                    <img
                      src={plato.imagen.replace(/\.webp$/, '-400.webp')}
                      width="400"
                      height="300"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="size-12 shrink-0 rounded-full object-cover ring-1 ring-crema/15"
                    />
                  )}
                  <span>
                    {plato.nombre}
                    {plato.descripcion && <span class="block text-sm text-crema/60">{plato.descripcion}</span>}
                  </span>
                </span>
                <span class="tabular-nums text-crema/80">{precio(plato.precio)}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
